diff --git a/src/loader/loader.h b/src/loader/loader.h
--- a/src/loader/loader.h
+++ b/src/loader/loader.h
@@ -73,8 +73,8 @@
 
 /* drmGetDevice2 and drmGetDevices2, and the DRM devices libdrm can't
  * describe: a node of an auxiliary device of a PCI function (gma500 puts the
- * Cedarview SGX there) is described as that PCI function, with its own
- * nodes.  Free the devices with drmFreeDevice. */
+ * Cedarview SGX there) keeps its own identity, using a platform-shaped
+ * descriptor and an auxiliary DRI_PRIME tag with either libdrm ABI.  Free the devices with drmFreeDevice. */
 int
 loader_drm_get_device(int fd, struct _drmDevice **device);
 
@@ -83,6 +83,13 @@
 
 /* (their sysfs part, for a sysfs tree at sysfs: the device of the node
  * maj:min; the nodes /sys/class/drm has that libdrm's list doesn't) */
+#ifdef __linux__
+bool loader_drm_pci_id_from_sysfs(const char *sysfs, unsigned maj, unsigned min,
+                                int *vendor_id, int *chip_id);
+#endif
+
+char *loader_drm_device_id(struct _drmDevice *device);
+
 struct _drmDevice *
 loader_drm_device_from_sysfs(const char *sysfs, unsigned maj, unsigned min);
 
diff --git a/src/loader/tests/cedarview_sysfs_test.c b/src/loader/tests/cedarview_sysfs_test.c
--- a/src/loader/tests/cedarview_sysfs_test.c
+++ b/src/loader/tests/cedarview_sysfs_test.c
@@ -2,20 +2,9 @@
  * Copyright © 2026 Joseph Telaak
  * SPDX-License-Identifier: MIT
  *
- * The loader on the sysfs layout of a real Cedarview (D2500) with gma500 and
- * powervr_sgx: the display's card0 on the PCI function 0000:00:02.0
- * (8086:0be1, subsystem 1558:2100, rev 0b), the SGX's card1 and renderD128 on
- * gma500's auxiliary device gma500_gfx.sgx.16, beside ACPI's
- * acpi.video_bus.0.  libdrm describes no auxiliary device (drmGetDevice2
- * fails on renderD128), so the loader describes it as the PCI function:
- *  - kmsro's pick: card0's child render node is renderD128;
- *  - loader_drm_device_from_sysfs: renderD128 and card1 are a PCI device
- *    0000:00:02.0, 8086:0be1, with nodes /dev/dri/card1 and
- *    /dev/dri/renderD128; card0 (the PCI function's own node) is left to
- *    libdrm;
- *  - loader_drm_add_sysfs_devices: libdrm's list (gma500 alone, no render
- *    node) gets the SGX added once, which is the EGLDevice that X11, gbm and
- *    surfaceless displays find.
+ * Auxiliary nodes retain a distinct, stable DRI_PRIME identity using a
+ * platform-shaped descriptor that works with stock libdrm headers and ABI.
+ * The parent PCI display and its child render device must never share a tag.
  */
 
 #include <limits.h>
@@ -175,20 +164,21 @@
    CHECK(loader_find_child_render_node(p, parent, name, sizeof(name)));
    CHECK(!strcmp(name, "renderD128"));
 
-   /* the SGX's nodes are described as the PCI function */
+   /* Both SGX nodes describe the child, independently of parent identity. */
    for (unsigned min = 1; min <= 128; min += 127) {
       d = loader_drm_device_from_sysfs(root, 226, min);
       CHECK(d);
       if (!d)
          continue;
-      CHECK(d->bustype == DRM_BUS_PCI);
-      CHECK(d->businfo.pci->domain == 0 && d->businfo.pci->bus == 0 &&
-            d->businfo.pci->dev == 2 && d->businfo.pci->func == 0);
-      CHECK(d->deviceinfo.pci->vendor_id == 0x8086 &&
-            d->deviceinfo.pci->device_id == 0x0be1);
-      CHECK(d->deviceinfo.pci->subvendor_id == 0x1558 &&
-            d->deviceinfo.pci->subdevice_id == 0x2100 &&
-            d->deviceinfo.pci->revision_id == 0x0b);
+      CHECK(d->bustype == DRM_BUS_PLATFORM);
+      CHECK(!strcmp(d->businfo.platform->fullname,
+                    "auxiliary:aux-0000_00_02_0-gma500_gfx.sgx.16"));
+      int vendor, chip;
+      CHECK(loader_drm_pci_id_from_sysfs(root, 226, min, &vendor, &chip));
+      CHECK(vendor == 0x8086 && chip == 0x0be1);
+      char *tag = loader_drm_device_id(d);
+      CHECK(tag && !strcmp(tag, "aux-0000_00_02_0-gma500_gfx.sgx.16"));
+      free(tag);
       CHECK(d->available_nodes ==
             ((1 << DRM_NODE_PRIMARY) | (1 << DRM_NODE_RENDER)));
       CHECK(!strcmp(d->nodes[DRM_NODE_PRIMARY], "/dev/dri/card1"));
@@ -216,6 +206,20 @@
    free(list[0]->nodes[DRM_NODE_PRIMARY]);
    drmFreeDevice(&list[0]);
 
+   /* An unplug after discovery cannot change the stored tag or collapse
+    * the child into its parent. No live sysfs lookup belongs in equality.
+    */
+   d = loader_drm_device_from_sysfs(root, 226, 128);
+   CHECK(d);
+   snprintf(p, sizeof(p), "%s/dev/char/226:128", root);
+   CHECK(!unlink(p));
+   if (d) {
+      char *tag = loader_drm_device_id(d);
+      CHECK(tag && !strcmp(tag, "aux-0000_00_02_0-gma500_gfx.sgx.16"));
+      free(tag);
+      drmFreeDevice(&d);
+   }
+
    if (!failures)
       printf("cedarview sysfs: all passed\n");
    return failures != 0;
