 /* the render nodes in sysfs/class/drm that none of devices[0..n) has, as
@@ -648,6 +631,26 @@
 
    if (n < 0)
       n = 0;
+#ifdef __linux__
+   /* Normalize recognized auxiliary nodes too: a private libdrm may describe
+    * them with an extended bus type unknown to the headers used here.
+    */
+   for (int i = 0; devices && i < n; i++) {
+      for (int node = 0; node < DRM_NODE_MAX; node++) {
+         struct stat st;
+         if (!(devices[i]->available_nodes & (1 << node)) ||
+             stat(devices[i]->nodes[node], &st) || !S_ISCHR(st.st_mode))
+            continue;
+         drmDevicePtr auxiliary = loader_drm_device_from_sysfs(
+            "/sys", major(st.st_rdev), minor(st.st_rdev));
+         if (auxiliary) {
+            drmFreeDevice(&devices[i]);
+            devices[i] = auxiliary;
+         }
+         break;
+      }
+   }
+#endif
    return loader_drm_add_sysfs_devices("/sys", devices, n, max_devices);
 }
 
